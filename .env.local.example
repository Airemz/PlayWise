# Required: RAWG API key (https://rawg.io/apidocs)
RAWG_API_KEY=

# Required: Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Required: MongoDB connection string (Atlas or local)
MONGODB_URI=
MONGODB_DB=playwise

# Optional: override Gemini model name
# Free-tier friendly options (as of 2026): gemini-2.5-flash, gemini-2.5-flash-lite
# Note: gemini-2.0-flash free-tier quota is restricted on many newer projects.
GEMINI_MODEL=gemini-2.5-flash
